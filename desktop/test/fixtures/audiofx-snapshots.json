  "defaults": "[0:a]pan=stereo|c0=c0|c1=c0[out]"
 },
 "right_only": {
  "defaults": "[0:a]pan=stereo|c0=c1|c1=c1[out]"
 },
 "invert_polarity": {
  "defaults": "[0:a]pan=stereo|c0=-1*c0|c1=-1*c1[out]",
  "values": "[0:a]pan=stereo|c0=c0|c1=-1*c1[out]"
 },
 "mono_to_stereo": {
  "defaults": "[0:a]pan=mono|c0=0.5*c0+0.5*c1,asplit=2[c0e0m][c0e0md];[c0e0md]adelay=delays=12:all=1[c0e0dl];[c0e0m][c0e0dl]amerge=inputs=2,pan=stereo|c0=c0+0.5*c1|c1=c0-0.5*c1[c0g0];[c0g0]anull[out]"
 },
 "delay_sync": {
  "defaults": "[0:a]anull[out]",
  "values": "[0:a]adelay=delays=20:all=1[out]"
 }
}
