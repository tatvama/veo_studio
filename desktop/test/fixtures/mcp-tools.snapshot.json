  {
    "name": "run_ai_tool",
    "readOnly": false,
    "input": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "enum": [
            "captions",
            "translate_captions",
            "voice_over",
            "music",
            "sound_effect",
            "clean_voice",
            "dub"
          ]
        },
        "args": {
          "type": "object",
          "properties": {
            "clip_ids": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 80
              }
            },
            "language": {
              "type": "string",
              "maxLength": 10
            },
            "languages": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 10
              }
            },
            "text": {
              "type": "string",
              "maxLength": 5000
            },
            "prompt": {
              "type": "string",
              "maxLength": 1000
            },
            "seconds": {
              "type": "number",
              "minimum": 1,
              "maximum": 600
            },
            "at": {
              "type": "number",
              "minimum": 0,
              "maximum": 86400,
              "description": "Timeline time"
            },
            "volume_db": {
              "type": "number",
              "minimum": -40,
              "maximum": 6
            },
            "target": {
              "type": "string",
              "maxLength": 10
            }
          },
          "description": "captions: clip_ids?, language · translate_captions: languages · voice_over: text, language · music: prompt, seconds, at?, volume_db? · sound_effect: prompt, seconds · clean_voice: clip_ids · dub: clip_ids (one), target"
        },
        "approve": {
          "description": "Approve within budgets (needs the spend scope)",
          "type": "boolean"
        }
      },
      "required": [
        "tool",
        "args"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  }
