    "input": {
      "type": "object",
      "properties": {
        "preset": {
          "description": "A preset id from list_presets (default draft720, a fast 720p H.264 draft)",
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "range": {
          "type": "string",
          "enum": [
            "all",
            "inout"
          ]
        },
        "name": {
          "description": "Output base name (default the sequence name); never a path",
          "type": "string",
          "maxLength": 100
        },
        "sequence_id": {
          "type": "string",
          "maxLength": 80
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "render_status",
