{
  "name": "tatvam-desktop",
  "version": "3.0.0",
  "productName": "Tatvam Studio",
  "private": true,
  "description": "Tatvam Studio: the desktop finishing room (Electron shell around the web studio)",
  "author": "Tatvam <team@taatvam.com>",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-reporter=spec \"test/*.test.ts\"",
    "smoke": "node scripts/smoke.mjs",
    "dist": "node scripts/build.mjs && node scripts/prepare-dist.mjs && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "zod": "4.6.5"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "engines": {
    "node": ">=24"
  }
}
