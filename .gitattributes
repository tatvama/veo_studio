# Store text with LF in the repository on every OS (Windows checkouts may still show CRLF in the editor).
* text=auto eol=lf

# Windows scripts keep CRLF so cmd and older PowerShell read them correctly.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets: never diff or convert.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.mp4  binary
*.mp3  binary
*.wav  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.pdf  binary

# Lockfiles: collapse in GitHub diffs.
frontend/package-lock.json linguist-generated=true
