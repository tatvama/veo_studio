# Copy this file to .env and fill it in. Never commit .env or paste keys into chat.
# (Admins can also paste API keys in the app: Settings → API keys. Keys saved there are encrypted with APP_SECRET.)

# ── AI services ──────────────────────────────────────────────────────────────
# Google Gemini API (Veo, Omni, Nano Banana, TTS, Lyria, Gemini) — needs billing enabled for Veo
GEMINI_API_KEY=
# ElevenLabs (voice changer + premium TTS)
ELEVENLABS_API_KEY=
# sync.so (lip-sync)
SYNC_API_KEY=
# Optional: Sarvam AI (Indian-language TTS)
SARVAM_API_KEY=
# fal.ai: the Model Hub (Kling, Seedance, Wan, MiniMax, LTX, sync, HeyGen … ~800 models) and identity training
FAL_KEY=
# Optional: OpenRouter, one key for many video models (Seedance, Kling, Wan, Veo, Hailuo …) and text; pay per use
OPENROUTER_API_KEY=
# Optional: BytePlus ModelArk (ByteDance direct): API key for Seedance video + Seedream images
BYTEPLUS_API_KEY=
# BytePlus IAM access key + secret: register AI characters in the asset library so Seedance keeps them consistent
# (needs STORAGE_BACKEND=s3: BytePlus downloads the images by link)
BYTEPLUS_ACCESS_KEY=
BYTEPLUS_SECRET_KEY=
BYTEPLUS_REGION=ap-southeast-1
BYTEPLUS_PROJECT=default

# auto = use free placeholder output when a key is missing; false = fail instead; true = always placeholders
MOCK_PROVIDERS=auto
# Google caps paid spend per rolling 10 minutes by usage tier: Tier 1 = 10, Tier 2 = 50, Tier 3 = 200 (USD).
# Veo jobs wait in the queue instead of crossing it. 0 = off.
GEMINI_SPEND_PER_10MIN=10
# Rupee figures use the live USD to INR rate. Set a number here (for example 94.5) to pin your own rate. 0 = live.
USD_INR_RATE=0

# ── App ──────────────────────────────────────────────────────────────────────
# A long random string. Signs logins and encrypts saved API keys. Changing it logs everyone out
# and makes keys saved in the app unreadable (re-enter them).
APP_SECRET=change-me-to-a-long-random-string
# The address people use to open the studio (Cloudflare Tunnel hostname or http://<unraid-ip>:8100)
PUBLIC_BASE_URL=http://localhost:8100
# Set true when served over HTTPS (Cloudflare Tunnel / VPS with TLS)
COOKIE_SECURE=false
WORKER_CONCURRENCY=4

# MCP server for Claude Code / Claude Desktop / claude.ai at <PUBLIC_BASE_URL>/mcp (see docs/MCP.md). Tokens are
# made in the app: Settings → MCP access. Sign-in for claude.ai connectors needs an HTTPS PUBLIC_BASE_URL.
MCP_ENABLED=true
# Extra host names the MCP endpoint answers to (comma separated). PUBLIC_BASE_URL's host and localhost always work.
MCP_ALLOWED_HOSTS=

# Database: leave empty for SQLite in ./data (fine for one machine). docker-compose sets Postgres automatically.
DATABASE_URL=
POSTGRES_PASSWORD=change-me
# Postgres pool per process: up to DB_POOL_SIZE + DB_MAX_OVERFLOW connections. Keep (pool + overflow) x processes
# well under the server's max_connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Optional ─────────────────────────────────────────────────────────────────
# Google sign-in (Google Cloud Console → OAuth client, redirect URI: <PUBLIC_BASE_URL>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Let anyone with these email domains sign in with Google as a Viewer (comma separated). Empty = invited emails only.
ALLOWED_GOOGLE_DOMAINS=

# Media storage. local = this machine's disk only. s3 = Cloudflare R2 / S3 bucket is the shared store and the
# local media folder is a cache: saves are uploaded, and files made elsewhere are downloaded when first needed.
# R2: S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com, plus an R2 API token's access key id + secret.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cloudflare Tunnel token (docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=

# Phase 0 test budget in USD (spike/run_spike.py stops before exceeding it)
SPIKE_BUDGET_USD=30
